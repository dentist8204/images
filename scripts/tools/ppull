#!/usr/bin/python3

import base64
import json
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) != 2:
    raise UsageError("<container>")

  container_name                          = sys.argv[1]
  (user_settings, settings, context_path) = utils.load_settings(container_name)
  container_source                        = f"{user_settings['registry']}/{container_name}"

  result = subprocess.run(["cosign", "verify",
                            f"--certificate-identity={user_settings['certificate-identity']}",
                            f"--certificate-oidc-issuer={user_settings['certificate-oidc-issuer']}",
                            f"{container_source}:latest"], check=True, stdout=subprocess.PIPE, text=True)

  output = json.loads(result.stdout.strip())

  utils.check_structure("verify_output", output, schema.VERIFY_OUTPUT)

  for attachment in output:
    if attachment["critical"]["type"] == "https://sigstore.dev/cosign/sign/v1":
      index_digest = attachment["critical"]["image"]["docker-manifest-digest"]
      break
  else:
    raise AppError("could not find https://sigstore.dev/cosign/sign/v1 in verify output")

  result = subprocess.run(["cosign", "verify-attestation", "--type=https://seccomp-profile.local",
                            f"--certificate-identity={user_settings['certificate-identity']}",
                            f"--certificate-oidc-issuer={user_settings['certificate-oidc-issuer']}",
                            f"{container_source}@{index_digest}"], check=True, stdout=subprocess.PIPE,
                          text=True)

  output = json.loads(result.stdout.strip())

  utils.check_structure("attest_output", output, schema.ATTEST_OUTPUT)

  output = json.loads(base64.b64decode(output["payload"]).decode('utf-8'))

  utils.check_structure("attest_payload", output, schema.ATTEST_PAYLOAD)

  seccomp_profile = output["predicate"]

  if seccomp_profile["defaultAction"] != "SCMP_ACT_ERRNO":
    raise AppError("pulled seccomp profile is not an allow list")

  seccomp_config_path = user_settings["seccomp-config-path"]

  replacements = utils.load_json("replacements", f"{seccomp_config_path}/replacements.json",
                                 schema.A_DICT)

  allowance  = set(utils.load_json("allowance", f"{seccomp_config_path}/allowance.json", schema.A_DICT))
  allowance -= set(replacements)

  for name in seccomp_profile["syscalls"][0]["names"]:
    if name not in allowance:
      raise AppError(f"pulled seccomp profile allows denied syscall: {name}")

  for i in range(1, len(seccomp_profile["syscalls"])):
    entry = seccomp_profile["syscalls"][i]

    action = entry["action"]

    if action == "SCMP_ACT_ERRNO":
      break

    if action != "SCMP_ACT_ALLOW":
      raise AppError(f"seccomp_profile.syscalls[{i}].action = {action} is disallowed")

    if len(entry["names"]) != 1:
      raise AppError(f"seccomp_profile.syscalls[{i}].names is not length 1")

    allowed = [rule["args"] for rule in replacements.get(entry["names"][0], [])]

    if "args" not in entry:
      raise AppError(f"seccomp_profile.syscalls[{i}].args is missing")

    if entry["args"] not in allowed:
      raise AppError(f"seccomp_profile.syscalls[{i}] is not a valid replacement: {entry}")

  result = subprocess.run(["podman", "pull", "--tls-verify", "--policy=always", "--quiet",
                            f"{container_source}@{index_digest}"], check=True, stdout=subprocess.PIPE,
                          text=True)

  subprocess.run(["podman", "untag", f"{container_source}:latest"], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL)

  subprocess.run(["podman", "tag", f"{result.stdout.strip()}", f"{container_source}:latest"], check=True)

  with open(f"{context_path}/seccomp.json", "w", encoding="utf-8") as output_file:
    json.dump(seccomp_profile, output_file, indent=2)

if __name__ == "__main__":
  utils.run_main(main, "ppull")
