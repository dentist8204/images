#!/usr/bin/python3 -B

import base64
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) != 2:
    raise UsageError("<container>")

  container_name                          = sys.argv[1]
  (user_settings, settings, context_path) = utils.load_settings(container_name)

  registry                = utils.get_value('registry', user_settings)
  certificate_identity    = utils.get_value('certificate-identity', user_settings)
  certificate_oidc_issuer = utils.get_value('certificate-oidc-issuer', user_settings)

  container_source = f"{registry}/{container_name}"

  result = subprocess.run(["cosign", "verify",
                            f"--certificate-identity={certificate_identity}",
                            f"--certificate-oidc-issuer={certificate_oidc_issuer}",
                            f"{container_source}:latest"], check=True, stdout=subprocess.PIPE, text=True)

  output = json.loads(result.stdout.strip())

  utils.check_structure("verify_output", output, schema.VERIFY_OUTPUT)

  for attachment in output:
    if attachment["critical"]["type"] == "https://sigstore.dev/cosign/sign/v1":
      new_digest = attachment["critical"]["image"]["docker-manifest-digest"]
      break
  else:
    raise AppError("could not find https://sigstore.dev/cosign/sign/v1 in verify output")

  try:
    new_digest_value = new_digest.split(":")[1]
  except IndexError:
    raise AppError(f"New digest has an unexpected format: {new_digest}")

  try:
    current_digest = utils.load_json("reference", f"{context_path}/reference.json",
                                     schema.REFERENCE)['digest']
  except FileNotFoundError:
    current_digest = "sha256:0"

  try:
    current_digest_value = current_digest.split(":")[1]
  except IndexError:
    raise AppError(f"Current digest has an unexpected format: {current_digest}")

  if current_digest == new_digest:
    sys.exit(0)

  result = subprocess.run(["cosign", "verify-attestation", "--type=https://seccomp-profile.local",
                            f"--certificate-identity={certificate_identity}",
                            f"--certificate-oidc-issuer={certificate_oidc_issuer}",
                            f"{container_source}@{new_digest}"], check=True, stdout=subprocess.PIPE,
                          text=True)

  output = json.loads(result.stdout.strip())

  utils.check_structure("attest_output", output, schema.ATTEST_OUTPUT)

  output = json.loads(base64.b64decode(output["payload"]).decode('utf-8'))

  utils.check_structure("attest_payload", output, schema.ATTEST_PAYLOAD)

  seccomp_profile = output["predicate"]

  if seccomp_profile["defaultAction"] != "SCMP_ACT_ERRNO":
    raise AppError("pulled seccomp profile is not an allow list")

  config_path = Path.home() / ".config" / "prun"

  replacements = utils.load_json("replacements", f"{config_path}/replacements.json",
                                 schema.A_DICT)

  allowance  = set(utils.load_json("allowance", f"{config_path}/allowance.json", schema.A_DICT))
  allowance -= set(replacements)

  for name in seccomp_profile["syscalls"][0]["names"]:
    if name not in allowance:
      raise AppError(f"pulled seccomp profile allows denied syscall: {name}")

  for (i, entry) in enumerate(seccomp_profile["syscalls"][1:], start=1):
    action = entry["action"]

    if action == "SCMP_ACT_ERRNO":
      continue

    if action != "SCMP_ACT_ALLOW":
      raise AppError(f"seccomp_profile.syscalls[{i}].action = {action} is disallowed")

    if len(entry["names"]) != 1:
      raise AppError(f"seccomp_profile.syscalls[{i}].names is not length 1")

    allowed = [rule["args"] for rule in replacements.get(entry["names"][0], [])]

    if "args" not in entry:
      raise AppError(f"seccomp_profile.syscalls[{i}].args is missing")

    if entry["args"] not in allowed:
      raise AppError(f"seccomp_profile.syscalls[{i}] is not a valid replacement: {entry}")

  os.makedirs(f"{context_path}/{new_digest_value}", 0o700, exist_ok=True)

  with open(f"{context_path}/{new_digest_value}/seccomp.json", "w", encoding="utf-8") as output_file:
    json.dump(seccomp_profile, output_file, indent=2)

  result = subprocess.run(["podman", "pull", "--tls-verify", "--policy=always", "--quiet",
                            f"{container_source}@{new_digest}"], check=True, stdout=subprocess.PIPE,
                          text=True)

  new_reference = {
    "registry": registry,
    "digest": new_digest
  }

  with open(f"{context_path}/reference-staged.json", "w", encoding="utf-8") as output_file:
    json.dump(new_reference, output_file, indent=2)

  os.replace(f"{context_path}/reference-staged.json", f"{context_path}/reference.json")

  try:
    shutil.rmtree(f"{context_path}/{current_digest_value}")
  except FileNotFoundError:
    pass

  subprocess.run(["podman", "rmi", f"{container_name}@{current_digest}"],
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
  utils.run_main(main, "ppull")
