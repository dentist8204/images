#!/usr/bin/python3 -B

import base64
import binascii
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) != 2:
    raise UsageError("<container>")

  container_name = sys.argv[1]
  settings       = utils.load_settings(container_name, {"certificate-identity", "certificate-oidc-issuer",
                                                        "registry"})

  registry                = settings["registry"]
  certificate_identity    = settings["certificate-identity"]
  certificate_oidc_issuer = settings["certificate-oidc-issuer"]

  container_source = f"{registry}/{container_name}"

  result = subprocess.run(["cosign", "verify",
                            f"--certificate-identity={certificate_identity}",
                            f"--certificate-oidc-issuer={certificate_oidc_issuer}",
                            f"{container_source}:latest"], check=True, stdout=subprocess.PIPE, text=True)

  output = load_jsons("verify_output", result.stdout.strip(), schema.VERIFY_OUTPUT)

  for attachment in output:
    if attachment["critical"]["type"] == "https://sigstore.dev/cosign/sign/v1":
      new_digest = attachment["critical"]["image"]["docker-manifest-digest"]
      break
  else:
    raise AppError("could not find https://sigstore.dev/cosign/sign/v1 in verify output")

  try:
    new_digest_value = new_digest.split(":")[1]
  except IndexError:
    raise AppError(f"New digest has an unexpected format: {new_digest}")

  context_path = settings["context-path"]

  try:
    current_digest = utils.load_json("reference", context_path / "reference.json",
                                     schema.REFERENCE)["digest"]
  except FileNotFoundError:
    current_digest = "sha256:0"

  try:
    current_digest_value = current_digest.split(":")[1]
  except IndexError:
    raise AppError(f"Current digest has an unexpected format: {current_digest}")

  if current_digest == new_digest:
    sys.exit(0)

  result = subprocess.run(["cosign", "verify-attestation", "--type=https://seccomp-profile.local",
                            f"--certificate-identity={certificate_identity}",
                            f"--certificate-oidc-issuer={certificate_oidc_issuer}",
                            f"{container_source}@{new_digest}"], check=True, stdout=subprocess.PIPE,
                          text=True)

  output = load_jsons("attest_output", result.stdout.strip(), schema.ATTEST_OUTPUT)

  try:
    output = load_jsons("attest_payload", base64.b64decode(output["payload"]).decode("utf-8"),
                        schema.ATTEST_PAYLOAD)
  except (binascii.Error, UnicodeDecodeError) as e:
    raise AppError(f"attest_payload is malformed: {e}")

  seccomp_profile = output["predicate"]

  config_path = Path.home() / ".config" / "prun"

  replacements = utils.load_json("replacements", config_path / "replacements.json", schema.DICT)

  allowance  = set(utils.load_json("allowance", config_path / "allowance.json", schema.DICT))
  allowance -= set(replacements)

  for name in seccomp_profile["syscalls"][0]["names"]:
    if name not in allowance:
      raise AppError(f"pulled seccomp profile allows denied syscall: {name}")

  for (i, entry) in enumerate(seccomp_profile["syscalls"][1:], start=1):
    action = entry["action"]

    if action == "SCMP_ACT_ERRNO":
      continue

    if len(entry["names"]) != 1:
      raise AppError(f"seccomp_profile.syscalls[{i}].names is not length 1")

    allowed = [rule["args"] for rule in replacements.get(entry["names"][0], [])]

    if "args" not in entry:
      raise AppError(f"seccomp_profile.syscalls[{i}].args is missing")

    if entry["args"] not in allowed:
      raise AppError(f"seccomp_profile.syscalls[{i}] is not a valid replacement: {entry}")

  new_context_path = context_path / new_digest_value

  os.makedirs(new_context_path, 0o700, exist_ok=True)

  with open(new_context_path / "seccomp.json", "w", encoding="utf-8") as output_file:
    json.dump(seccomp_profile, output_file, separators=(",", ":"))

  subprocess.run(["podman", "pull", "--tls-verify", "--policy=always", f"{container_source}@{new_digest}"],
                 check=True)

  new_reference = {
    "registry": registry,
    "digest": new_digest
  }

  staged_reference_path = context_path / "reference-staged.json"

  with open(staged_reference_path, "w", encoding="utf-8") as output_file:
    json.dump(new_reference, output_file, separators=(",", ":"))

  os.replace(staged_reference_path, context_path / "reference.json")

  try:
    shutil.rmtree(context_path / current_digest_value)
  except FileNotFoundError:
    pass

  subprocess.run(["podman", "rmi", f"{container_name}@{current_digest}"],
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def load_jsons(name, raw_data, schema_):
  # 500 KiB
  if len(raw_data) > 512000:
    raise AppError(f"{name} is too large to be decoded safely")

  try:
    json_data = json.loads(raw_data)
  except json.JSONDecodeError as e:
    raise AppError(f"{name}: {e}")

  utils.validate_data(name, json_data, schema_)

  return json_data

if __name__ == "__main__":
  utils.run_main(main, "ppull")
