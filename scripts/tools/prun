#!/usr/bin/python3 -B

import os
from pathlib import Path
import secrets
import shutil
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) < 3:
    raise UsageError("<container> <command> [args...]")

  container_name = sys.argv[1]
  container_id   = "prun.id." + secrets.token_urlsafe(16)
  run_args       = ["podman", "run", "--rm", "--cap-drop=all", "--runtime=crun", "--log-driver=none",
                    "--pull=never", "--read-only", "--ulimit=core=0:0", "--ulimit=memlock=0:0",
                    "--ulimit=msgqueue=0:0", "--cgroupns=private", "--ipc=private", "--pid=private",
                    "--uts=private", "--security-opt=no-new-privileges", "--pids-limit=256"]

  run_args.append(f"--name={container_id}")

  settings = utils.load_settings(container_name, {"network", "uid", "cpu-period", "cpu-quota", "memory",
                                                  "disk-bps", "disk-iops", "nofile", "locks", "sigpending",
                                                  "sandbox-path", "disk-name", "mount-parent",
                                                  "working-dir", "volumes", "env"})

  run_args.append(f"--workdir={settings['working-dir']}")

  if (settings["network"]):
    run_args.append("--network=private")
  else:
    run_args.append("--network=none")

  for var in settings["env"]:
    run_args.append(f"--env={var}")

  run_args.extend([f"--userns=keep-id:uid={settings["uid"]},gid={settings["uid"]}",
                   f"--cpu-period={settings['cpu-period']}",
                   f"--cpu-quota={settings['cpu-quota']}",
                   f"--memory={settings['memory']}m",
                   f"--device-read-bps={settings["disk-name"]}:{settings["disk-bps"]}mb",
                   f"--device-write-bps={settings["disk-name"]}:{settings["disk-bps"]}mb",
                   f"--device-read-iops={settings["disk-name"]}:{settings["disk-iops"]}",
                   f"--device-write-iops={settings["disk-name"]}:{settings["disk-iops"]}",
                   f"--ulimit=nofile={settings["nofile"]}:{settings["nofile"]}",
                   f"--ulimit=locks={settings["locks"]}:{settings["locks"]}",
                   f"--ulimit=sigpending={settings["sigpending"]}:{settings["sigpending"]}"])

  context_path = settings["context-path"]

  reference = utils.load_json("reference", context_path / "reference.json", schema.REFERENCE)

  digest = reference["digest"]

  run_args.append(f"--security-opt=seccomp={context_path / digest.split(':')[1] / 'seccomp.json'}")

  volume_writable = {}
  volumes         = []

  for volume in settings["volumes"]["read-write"]:
    if volume in volume_writable:
      raise AppError(f"duplicate volume: {volume}")

    volume_writable[volume] = True

    volumes.append(volume)

  for volume in settings["volumes"]["read-only"]:
    if volume in volume_writable:
      raise AppError(f"duplicate volume: {volume}")

    volume_writable[volume] = False

    volumes.append(volume)

  volumes.sort()

  sandbox_path = Path(settings["sandbox-path"], container_name)
  mount_parent = Path(settings["mount-parent"])

  for volume in volumes:
    volume_flag = f"--volume={sandbox_path / volume}:{mount_parent / volume}:Z,nosuid,nodev"

    if (volume_writable[volume]):
      volume_flag += ",rw"
    else:
      volume_flag += ",ro"

    run_args.append(volume_flag)

  run_args.append(f"{reference['registry']}/{container_name}@{digest}")
  run_args.extend(sys.argv[2:])

  if not shutil.which("podman"):
    raise AppError("podman is not available on this system")

  try:
    subprocess.run(run_args, check=True)
  except subprocess.CalledProcessError as e:
    raise AppError(f"podman-run failed with return code {e.returncode}")
  finally:
    subprocess.run(["podman", "stop", "--time=3", container_id], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)

    if shutil.which("restorecon"):
      subprocess.run(["restorecon", "-RF", sandbox_path], check=True)

if __name__ == "__main__":
  utils.run_main(main, "prun")
