#!/usr/bin/python3 -EBs

import os
import secrets
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) < 3:
    raise UsageError("<container> <command> [args...]")

  container_name = sys.argv[1]
  container_id   = "prun.id." + secrets.token_urlsafe(16)
  run_args       = ["podman", "create", "--rm", "--cap-drop=all", "--runtime=crun", "--log-driver=none",
                    "--pull=never", "--read-only", "--ulimit=nofile=1024:1024", "--ulimit=locks=1024:1024",
                    "--ulimit=sigpending=1024:1024", "--ulimit=core=0:0", "--ulimit=memlock=0:0",
                    "--ulimit=msgqueue=0:0", "--cgroupns=private", "--ipc=private", "--pid=private",
                    "--uts=private", "--security-opt=no-new-privileges", "--pids-limit=256"]

  run_args.append(f"--name={container_id}")

  (user_settings, settings, context_path) = utils.load_settings(container_name)

  run_args.append(f"--workdir={settings['working-dir']}")

  if (settings["network"]):
    run_args.append("--network=private")
  else:
    run_args.append("--network=none")

  for (var, val) in settings["env"].items():
    utils.check_structure(f"settings.env.{var}", val, schema.ENV)

    run_args.append(f"--env={var}={val}")

  device_name = user_settings["disk-name"]
  uid         = utils.get_value("uid", user_settings, settings)
  disk_bps    = utils.get_value("disk-bps", user_settings, settings)
  disk_iops   = utils.get_value("disk-iops", user_settings, settings)

  run_args.extend([f"--userns=keep-id:uid={uid},gid={uid}",
                   f"--cpu-period={utils.get_value('cpu-period', user_settings, settings)}",
                   f"--cpu-quota={utils.get_value('cpu-quota', user_settings, settings)}",
                   f"--memory={utils.get_value('memory', user_settings, settings)}m",
                   f"--device-read-bps={device_name}:{disk_bps}mb",
                   f"--device-write-bps={device_name}:{disk_bps}mb",
                   f"--device-read-iops={device_name}:{disk_iops}",
                   f"--device-write-iops={device_name}:{disk_iops}"])

  reference = utils.load_json("reference", f"{context_path}/reference.json", schema.REFERENCE)

  digest = reference['digest']

  try:
    run_args.append(f"--security-opt=seccomp={context_path}/{digest.split(':')[1]}/seccomp.json")
  except IndexError:
    raise AppError(f"reference.digest has an unexpected format: {digest}")

  volume_writable = {}
  volumes         = []

  for volume in settings["volumes"]["read_write"]:
    if volume in volume_writable:
      raise AppError(f"duplicate volume: {volume}")

    volume_writable[volume] = True

    volumes.append(volume)

  for volume in settings["volumes"]["read_only"]:
    if volume in volume_writable:
      raise AppError(f"duplicate volume: {volume}")

    volume_writable[volume] = False

    volumes.append(volume)

  volumes.sort()

  temp_path    = f"{user_settings['tmpfs-path']}/{container_id}"
  sandbox_path = os.path.abspath(f"{user_settings['sandbox-path']}/{container_name}")
  mount_parent = settings["mount-parent"]

  for volume in volumes:
    if (volume_writable[volume]):
      run_args.append(f"--volume={temp_path}/{volume}:{mount_parent}/{volume}:Z,rw,nosuid,nodev")
    else:
      run_args.append(f"--volume={sandbox_path}/{volume}:{mount_parent}/{volume}:Z,ro,nosuid,nodev")

  run_args.append(f"{reference['registry']}/{container_name}@{digest}")
  run_args.extend(sys.argv[2:])

  try:
    os.mkdir(temp_path, 0o700)

    subprocess.run(["rsync", "-Hrlpt", f"{sandbox_path}/", temp_path], stdout=subprocess.DEVNULL,
                   check=True)

    subprocess.run(run_args, check=True)

    subprocess.run(["podman", "start", "-a", container_id])

    hardlinks_max = utils.get_value("hardlinks-max", user_settings, settings)

    result = subprocess.run(["find", temp_path, "-mindepth", "1", "!", "-type", "d", "-links",
                             f"+{hardlinks_max}", "-printf", ".", "-quit"], check=True, capture_output=True)

    if len(result.stdout) > 0:
      raise AppError(f"{container_name} returned a file with too many hard links")

    result = subprocess.run(["find", temp_path, "-mindepth", "1", "!", "-type", "f",
                             "!", "-type", "d", "!", "-type", "l", "-printf", ".", "-quit"], check=True,
                            capture_output=True)

    if len(result.stdout) > 0:
      raise AppError(f"{container_name} returned weird files")

    subprocess.run(["rsync", "-Hrlpt", "--delete", f"{temp_path}/.", sandbox_path],
                   stdout=subprocess.DEVNULL, check=True)
  finally:
    subprocess.run(["podman", "stop", "--time=3", container_id], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)

    subprocess.run(["find", temp_path, "-delete"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    subprocess.run(["restorecon", "-RF", sandbox_path], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)

if __name__ == "__main__":
  utils.run_main(main, "prun")
