#!/usr/bin/python3

import os
import secrets
import subprocess
import sys

from errors import AppError, UsageError
import schema
import utils

def main():
  if len(sys.argv) < 3:
    raise UsageError("<container> <command> [args...]")

  container_name                          = sys.argv[1]
  (user_settings, settings, context_path) = utils.load_settings(container_name)

  volume_writable = {}
  volumes         = []

  for volume in settings["volumes"]["read_write"]:
    if volume in volume_writable:
      raise AppError(f"duplicated volume: {volume}")

    volume_writable[volume] = True

    volumes.append(volume)

  for volume in settings["volumes"]["read_only"]:
    if volume in volume_writable:
      raise AppError(f"duplicated volume: {volume}")

    volume_writable[volume] = False

    volumes.append(volume)

  volumes.sort()

  specs         = user_settings["specs"]
  device_bps    = int(specs["disk-bps"] / 8)
  device_iops   = int(specs["disk-iops"] / 8)
  device_name   = user_settings["disk_name"]
  random_suffix = secrets.token_urlsafe(16)
  container_id  = "prun.id." + random_suffix

  run_args = ["podman", "run", "--rm", f"--workdir={settings['working-dir']}", f"--name={container_id}",
              "--cap-drop=all", "--runtime=crun", "--log-driver=none", "--pull=never", "--read-only",
              "--cpu-period=100000", f"--cpu-quota={int(specs['cpus'] * 25000)}",
              f"--memory={int(specs['memory'] / 4)}m", "--pids-limit=256",
              f"--device-read-bps={device_name}:{device_bps}mb",
              f"--device-write-bps={device_name}:{device_bps}mb",
              f"--device-read-iops={device_name}:{device_iops}",
              f"--device-write-iops={device_name}:{device_iops}",
              "--ulimit=nofile=1024:1024", "--ulimit=locks=1024:1024", "--ulimit=sigpending=1024:1024",
              "--ulimit=core=0:0", "--ulimit=memlock=0:0", "--ulimit=msgqueue=0:0",
              "--cgroupns=private", "--ipc=private", "--pid=private", "--uts=private",
              "--userns=keep-id:uid=1007,gid=1007",
              "--security-opt=no-new-privileges", f"--security-opt=seccomp={context_path}/seccomp.json"]

  if (settings["network"]):
    run_args.append("--network=private")
  else:
    run_args.append("--network=none")

  for (var, val) in settings["env"].items():
    utils.check_structure(f"settings.env.{var}", val, schema.ENV)

    run_args.append(f"--env={var}={val}")

  mount_parent = settings["mount-parent"]

  # a safely sized tmpfs with a reasonable inode cap must be provided for proper resource isolation
  temp_path    = f"{user_settings['tmpfs_path']}/{container_id}"
  sandbox_path = os.path.abspath(f"{user_settings['sandbox_path']}/{container_name}")

  for volume in volumes:
    if (volume_writable[volume]):
      run_args.append(f"--volume={temp_path}/{volume}:{mount_parent}/{volume}:Z,rw,nosuid,nodev")
    else:
      run_args.append(f"--volume={sandbox_path}/{volume}:{mount_parent}/{volume}:Z,ro,nosuid,nodev")

  run_args.append(f"{user_settings['registry']}/{container_name}:latest")
  run_args.extend(sys.argv[2:])

  try:
    os.mkdir(temp_path, 0o700)

    subprocess.run(["rsync", "-Hrlpt", f"{sandbox_path}/", temp_path], stdout=subprocess.DEVNULL,
                   check=True)

    subprocess.run(run_args, check=True)

    # hardlink bomb check
    result = subprocess.run(["find", temp_path, "-mindepth", "1","-printf", "."], check=True,
                            capture_output=True)

    if len(result.stdout) > 262144:
      raise AppError(f"{container_name} returned too many files")

    result = subprocess.run(["find", temp_path, "-mindepth", "1", "!", "-type", "f",
                             "!", "-type", "d", "!", "-type", "l", "-printf", ".", "-quit"], check=True,
                            capture_output=True)

    if len(result.stdout) > 0:
      raise AppError(f"{container_name} returned weird files")

    subprocess.run(["rsync", "-Hrlpt", f"{temp_path}/.", sandbox_path], stdout=subprocess.DEVNULL,
                   check=True)
  finally:
    subprocess.run(["podman", "stop", container_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["podman", "kill", container_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if os.path.exists(temp_path):
      subprocess.run(["find", temp_path, "-delete"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    subprocess.run(["restorecon", "-RF", sandbox_path], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)

if __name__ == "__main__":
  utils.run_main(main, "prun")
