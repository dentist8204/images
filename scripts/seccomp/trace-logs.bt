BEGIN
{
  printf("READY\n");
}

/* defined in kernel/auditsc.c */
kprobe:audit_seccomp
{
  /* SECCOMP_RET_LOG defined in include/uapi/linux/seccomp.h */
  if (arg2 == 0x7ffc0000) {
    /* start tracking on the thread group that calls seccomp() */
    if (!@tracked[tid]) {
      @tracked[tid] = 1;

      @tracked_count[0]++;

      if (tid == pid) {
        @tracked_containers[0]++;
      }
    }

    /* exit and exit_group */
    if (arg0 == 60 || arg0 == 231) {
      @[arg0] = 1;
    } else {
      @logged[tid] = arg0 + 1;
    }
  }
}

tracepoint:raw_syscalls:sys_exit
/@logged[tid]/
{
  if (args->ret > -1) {
    @[@logged[tid] - 1] = 1;
  } else {
    @error[@logged[tid] - 1] = -args->ret;
  }
  
  delete(@logged[tid]);
}

tracepoint:sched:sched_process_fork
/@tracked[tid]/
{
  @tracked[args->child_pid] = 1;
  @tracked_count[0]++;
}

tracepoint:sched:sched_process_exit
{
  delete(@logged[tid]);
}
