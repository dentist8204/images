#include <asm/unistd.h>

/* defined in include/uapi/linux/seccomp.h */
#define SECCOMP_RET_LOG 0x7ffc0000

BEGIN
{
  printf("READY\n");
}

/* defined in kernel/auditsc.c */
kprobe:audit_seccomp
{
  if (arg2 == SECCOMP_RET_LOG) {
    /* start tracking on the thread group that calls seccomp() */
    if (!@tracked[tid]) {
      @tracked[tid] = 1;

      if (tid == pid) {
        @main_thread[tid] = 1;
      }
    }

    if (arg0 == __NR_exit || arg0 == __NR_exit_group) {
      @[arg0] = 1;
    } else {
      @logged[tid] = arg0 + 1;
    }
  }
}

tracepoint:raw_syscalls:sys_exit
/@logged[tid]/
{
  if (args->ret > -1) {
    @[@logged[tid] - 1] = 1;
  } else {
    @error[@logged[tid] - 1] = -args->ret;
  }
  
  delete(@logged[tid]);
}

tracepoint:sched:sched_process_fork
/@tracked[tid]/
{
  @tracked[args->child_pid] = 1;
}

tracepoint:sched:sched_process_exit
/@logged[tid]/
{
  delete(@logged[tid]);
}

tracepoint:sched:sched_process_exit
/@tracked[tid]/
{
  delete(@tracked[tid]);

  if (@main_thread[tid]) {
    @container_count[0]++;

    delete(@main_thread[tid]);
  }

  if (@container_count[0] == @@CONTAINER_COUNT@@) {
    printf("DONE\\n");
    exit();
  }
}
